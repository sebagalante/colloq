<%!-- Phone layout is one pane at a time (list OR thread), the way every chat app
      does it: side by side, the 20rem list left the thread ~4rem on a phone.
      `dvh` rather than `vh` so the pane isn't cut off by mobile browser chrome.
      From `md` up both panes show and the framing (padding, border, rounding)
      comes back. --%>
<%!-- The negative margins cancel the app layout's `main` padding so the chat goes
      edge to edge on a phone; from `md` the normal page framing returns. The
      height is the viewport minus the 3.5rem header (`dvh`, so mobile browser
      chrome doesn't cut the composer off) — with the padding cancelled there's
      nothing else to subtract, and the page itself never scrolls. --%>
<div
  id="chat-page"
  phx-hook="ChatFocus"
  class="-mx-4 sm:-mx-6 md:mx-auto -my-6 md:my-0 max-w-6xl md:px-4 md:py-6"
>
  <div class="flex h-[calc(100dvh-3.5rem)] md:h-[calc(100vh-140px)] md:border border-border md:rounded-2xl overflow-hidden bg-surface shadow-sm">
    <%!-- Conversation list sidebar --%>
    <div class={[
      "w-full md:w-80 border-r border-border flex-col flex-shrink-0 bg-surface",
      (@active_conversation && "hidden md:flex") || "flex"
    ]}>
      <div class="px-4 h-16 flex-shrink-0 border-b border-border flex items-center justify-between">
        <h2 class="text-lg font-bold text-heading"><%= gettext("Conversations") %></h2>
        <div class="flex items-center gap-1.5">
          <%!-- Unhidden by its hook only when the browser hasn't been asked yet. --%>
          <button
            type="button"
            id="chat-notify-permission"
            phx-hook="ChatNotifyPermission"
            data-confirm-title={gettext("Notifications are on")}
            data-confirm-body={gettext("You'll get an alert when a message arrives and this tab isn't focused.")}
            title={gettext("Notify me about new messages")}
            class="hidden p-1.5 rounded-full text-muted hover:text-heading hover:bg-border transition-colors"
          >
            <.icon name="bell" class="w-4 h-4" />
          </button>
          <button
            phx-click="open-new-conversation"
            class="inline-flex items-center gap-1 rounded-full bg-accent px-3 py-1.5 text-xs font-semibold text-white hover:bg-accent-hover transition-colors"
          >
            <.icon name="plus" class="w-3.5 h-3.5" /><%= gettext("New") %>
          </button>
        </div>
      </div>

      <div class="flex-1 overflow-y-auto py-1">
        <div :if={@conversations == []} class="px-6 py-10 text-center">
          <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-accent-soft flex items-center justify-center">
            <.icon name="mail" class="w-6 h-6 text-accent" />
          </div>
          <p class="text-muted text-sm"><%= gettext("You have no conversations.") %></p>
          <p class="text-muted text-xs mt-1"><%= gettext("Tap “+ New” above to start one.") %></p>
        </div>

        <div
          :for={conv <- @conversations}
          id={"conv-row-#{conv.id}"}
          class={[
            "group relative mx-1.5 my-0.5 rounded-xl flex items-stretch transition-colors",
            (@active_conversation && @active_conversation.id == conv.id && "bg-accent-soft") || "hover:bg-border/60"
          ]}
        >
          <% u = other_user(conv, @current_user) %>
          <% unread = Map.get(@unread_counts, conv.id, 0) %>
          <button
            phx-click="select_conversation"
            phx-value-id={conv.id}
            class="flex-1 min-w-0 px-3 py-2.5 text-left flex items-center gap-3"
          >
            <div class="relative flex-shrink-0">
              <img
                :if={u.avatar_url}
                src={u.avatar_url}
                alt=""
                class="w-11 h-11 rounded-full object-cover"
              />
              <div
                :if={!u.avatar_url}
                class="w-11 h-11 rounded-full bg-gradient-to-br from-accent to-accent-hover flex items-center justify-center text-base font-bold text-white"
              >
                <%= String.slice(u.display_name || u.username, 0..0) |> String.upcase() %>
              </div>
              <span
                :if={online?(u.id)}
                class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-success ring-2 ring-surface"
                title={gettext("Online")}
              >
              </span>
              <span :if={online?(u.id)} class="sr-only"><%= gettext("Online") %></span>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <span class={[
                  "text-sm text-heading truncate flex-1",
                  (unread > 0 && "font-bold") || "font-semibold"
                ]}>
                  <%= u.display_name || u.username %>
                </span>
                <span
                  :if={conv.last_message}
                  class={[
                    "text-[11px] flex-shrink-0",
                    (unread > 0 && "text-accent font-semibold") || "text-muted"
                  ]}
                >
                  <%= es_locale(conv.last_message.inserted_at) %>
                </span>
              </div>
              <%!-- Preview and the unread badge share the line, Telegram-style.
                    The badge sits flush with the row's right edge so it lines up
                    under the timestamp above it; `leading-none` centres the
                    digits in the pill, which the inherited line-height didn't. --%>
              <div class="flex items-center gap-2 mt-0.5">
                <p class={[
                  "text-xs truncate flex-1",
                  (unread > 0 && "text-body") || "text-muted"
                ]}>
                  <%= last_message_preview(conv) %>
                </p>
                <span
                  :if={unread > 0}
                  class="flex-shrink-0 min-w-[20px] h-5 px-1.5 rounded-full bg-accent text-white text-[11px] font-bold leading-none flex items-center justify-center"
                  title={ngettext("1 unread message", "%{count} unread messages", unread)}
                >
                  <%= min(unread, 99) %>
                </span>
              </div>
            </div>
          </button>
          <%!-- Row actions: a menu, not a bare trash bin. Parked on the top line
                (over the timestamp) rather than centred, so it doesn't sit on
                top of the unread badge on the line below. --%>
          <div class="absolute top-1.5 right-2">
            <button
              type="button"
              phx-click={
                Phoenix.LiveView.JS.toggle(to: "#conv-menu-#{conv.id}")
                |> Phoenix.LiveView.JS.toggle_class("z-40", to: "#conv-row-#{conv.id}")
              }
              title={gettext("More")}
              class="p-1.5 rounded-lg text-muted opacity-0 group-hover:opacity-100 hover:text-heading hover:bg-surface transition-all"
            >
              <.icon name="more-horizontal" class="w-4 h-4" />
            </button>
            <%!-- The row is lifted (z-40) while the menu is open so the menu isn't
                  painted under the rows below it; the transform on this wrapper
                  otherwise traps the menu's own z-index at the row's level. --%>
            <div
              id={"conv-menu-#{conv.id}"}
              phx-click-away={
                Phoenix.LiveView.JS.hide()
                |> Phoenix.LiveView.JS.remove_class("z-40", to: "#conv-row-#{conv.id}")
              }
              class="hidden absolute right-0 mt-1 bg-surface border border-border rounded-xl shadow-lg py-1 min-w-[190px] z-30"
            >
              <.link
                navigate={~p"/u/#{u.username}"}
                class="flex items-center gap-2.5 px-3 py-2 text-sm text-body hover:bg-border transition-colors"
              >
                <.icon name="user" class="w-4 h-4" /> <%= gettext("View profile") %>
              </.link>
              <button
                type="button"
                phx-click="mark-conversation-read"
                phx-value-id={conv.id}
                class="flex items-center gap-2.5 w-full text-left px-3 py-2 text-sm text-body hover:bg-border transition-colors"
              >
                <.icon name="check" class="w-4 h-4" /> <%= gettext("Mark as read") %>
              </button>
              <button
                type="button"
                phx-click="delete-conversation"
                phx-value-id={conv.id}
                data-confirm={gettext("Delete this conversation for you? The other person keeps their copy.")}
                class="flex items-center gap-2.5 w-full text-left px-3 py-2 text-sm text-danger hover:bg-danger-soft transition-colors"
              >
                <.icon name="trash-2" class="w-4 h-4" /> <%= gettext("Delete chat") %>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%!-- Message thread --%>
    <div :if={@active_conversation} class="flex-1 flex flex-col min-w-0">
      <% other = other_user(@active_conversation, @current_user) %>
      <% blocked? = other.id in @blocked_user_ids %>

      <%!-- Header --%>
      <div class="px-2 md:px-4 h-16 flex-shrink-0 border-b border-border flex items-center gap-2 md:gap-3 bg-surface">
        <%!-- The only way back to the list on a phone, where the list is hidden
              while a thread is open. --%>
        <.link
          patch={~p"/messages"}
          class="md:hidden p-2 -mr-1 rounded-full text-muted hover:text-heading hover:bg-border transition-colors"
          title={gettext("Back to conversations")}
        >
          <.icon name="chevron-left" class="w-5 h-5" />
        </.link>
        <div class="relative flex-shrink-0">
          <img
            :if={other.avatar_url}
            src={other.avatar_url}
            alt=""
            class="w-10 h-10 rounded-full object-cover"
          />
          <div
            :if={!other.avatar_url}
            class="w-10 h-10 rounded-full bg-gradient-to-br from-accent to-accent-hover flex items-center justify-center text-sm font-bold text-white"
          >
            <%= String.slice(other.display_name || other.username, 0..0) |> String.upcase() %>
          </div>
          <span
                :if={online?(other.id)}
                class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-success ring-2 ring-surface"
                title={gettext("Online")}
              >
              </span>
              <span :if={online?(other.id)} class="sr-only"><%= gettext("Online") %></span>
        </div>
        <.link navigate={~p"/u/#{other.username}"} class="min-w-0 no-underline">
          <p class="text-sm font-semibold text-heading truncate hover:underline">
            <%= other.display_name || other.username %>
          </p>
          <p class={["text-xs truncate", online?(other.id) && "text-success" || "text-muted"]}>
            <%= if online?(other.id), do: gettext("online"), else: "@#{other.username}" %>
          </p>
        </.link>

        <%!-- Conversation menu: profile / ignore / block / delete --%>
        <div class="relative ml-auto flex-shrink-0" id="conversation-menu">
          <button
            type="button"
            phx-click={Phoenix.LiveView.JS.toggle(to: "#conversation-options")}
            class="p-2 rounded-full text-muted hover:text-heading hover:bg-border transition-colors"
            title={gettext("Options")}
          >
            <.icon name="more-horizontal" class="w-5 h-5" />
          </button>
          <div
            id="conversation-options"
            phx-click-away={Phoenix.LiveView.JS.hide()}
            class="hidden absolute right-0 mt-1 bg-surface border border-border rounded-xl shadow-lg py-1 min-w-[210px] z-20"
          >
            <.link
              navigate={~p"/u/#{other.username}"}
              class="flex items-center gap-2.5 px-3 py-2 text-sm text-body hover:bg-border transition-colors"
            >
              <.icon name="user" class="w-4 h-4" /> <%= gettext("View profile") %>
            </.link>

            <button
              :if={!blocked?}
              type="button"
              phx-click="block-conversation"
              phx-value-mode="ignore"
              class="flex items-center gap-2.5 w-full text-left px-3 py-2 text-sm text-body hover:bg-border transition-colors"
            >
              <.icon name="bell-off" class="w-4 h-4" /> <%= gettext("Ignore") %>
            </button>
            <button
              :if={!blocked? && other.role not in Colloq.Permissions.roles()}
              type="button"
              phx-click="block-conversation"
              phx-value-mode="block"
              data-confirm={gettext("Block this user? Neither of you will be able to message the other.")}
              class="flex items-center gap-2.5 w-full text-left px-3 py-2 text-sm text-danger hover:bg-danger-soft transition-colors"
            >
              <.icon name="ban" class="w-4 h-4" /> <%= gettext("Block") %>
            </button>
            <button
              :if={blocked?}
              type="button"
              phx-click="unblock-conversation"
              class="flex items-center gap-2.5 w-full text-left px-3 py-2 text-sm text-body hover:bg-border transition-colors"
            >
              <.icon name="check" class="w-4 h-4" /> <%= gettext("Unblock") %>
            </button>

            <div class="my-1 border-t border-border"></div>
            <button
              type="button"
              phx-click="delete-conversation"
              phx-value-id={@active_conversation.id}
              data-confirm={gettext("Delete this conversation for you? The other person keeps their copy.")}
              class="flex items-center gap-2.5 w-full text-left px-3 py-2 text-sm text-danger hover:bg-danger-soft transition-colors"
            >
              <.icon name="trash-2" class="w-4 h-4" /> <%= gettext("Delete conversation") %>
            </button>
          </div>
        </div>
      </div>

      <div :if={blocked?} class="px-4 py-2 bg-danger-soft border-b border-danger-border text-xs text-danger text-center">
        <%= gettext("You blocked this user. They can't message you.") %>
      </div>

      <%!-- Messages --%>
      <div id="messages-container" phx-hook="AutoScroll" class="flex-1 overflow-y-auto px-4 py-4 chat-pattern">
        <%!-- min-h-full + justify-end keeps a short thread resting on the
             composer instead of floating at the top of an empty pane. Once the
             content is taller than the pane the container simply grows and the
             justification stops mattering. --%>
        <div class="max-w-3xl mx-auto flex flex-col min-h-full justify-end">
          <%!-- Scrolling to the top of the thread pulls in the previous page. --%>
          <div
            :if={@has_more_messages}
            id="chat-history-sentinel"
            phx-hook="ChatHistory"
            data-scroller="messages-container"
            class="flex justify-center py-3"
          >
            <span class="text-xs text-muted"><%= gettext("Loading earlier messages...") %></span>
          </div>
          <%!-- `contents` makes this wrapper invisible to the flex layout, so the
               day separator and the message row stay siblings of each other. --%>
          <div :for={row <- message_rows(@messages, @current_user.id)} class="contents">
          <div :if={row.day_break} class="flex justify-center my-3">
            <span class="px-2.5 py-1 rounded-full text-[11px] font-medium text-muted bg-surface/80 border border-border backdrop-blur-sm">
              <%= row.day_break %>
            </span>
          </div>
          <div
            id={"msg-row-#{row.msg.id}"}
            class={[
              "group flex items-end gap-1.5",
              row.mine && "justify-end" || "justify-start",
              # Big bubble-less emoji/sticker rows need more air between them than
              # the tight run-spacing used for text bubbles.
              cond do
                row.top -> "mt-3"
                emoji_only?(row.msg) or sticker?(row.msg) -> "mt-2.5"
                true -> "mt-0.5"
              end
            ]}
          >
            <.msg_actions :if={row.mine} row={row} />
            <%!-- Sticker: bare floating image, no bubble --%>
            <div :if={sticker?(row.msg)} class="relative max-w-[128px]">
              <%!-- Lottie/TGS: vector, mounted by JS. Raster stickers (animated
                   GIF/WebP/APNG) animate natively in an <img>. --%>
              <div
                :if={lottie_sticker?(row.msg)}
                id={"lottie-#{row.msg.id}"}
                phx-hook="LottieSticker"
                phx-update="ignore"
                data-src={row.msg.sticker_url}
                class="w-32 h-32 drop-shadow-sm"
              >
              </div>
              <img
                :if={!lottie_sticker?(row.msg)}
                src={row.msg.sticker_url}
                alt="sticker"
                class="w-32 h-32 object-contain drop-shadow-sm"
                loading="lazy"
              />
              <span class="absolute bottom-0 right-0 flex items-center gap-1 text-[10px] leading-none text-muted bg-bg/70 rounded px-1 py-0.5">
                <%= chat_time(row.msg.inserted_at) %>
                <.read_receipt :if={row.mine} read={row.msg.read} variant={:muted} />
              </span>
            </div>
            <%!-- Emoji-only: render large with no bubble (WhatsApp/Telegram-style) --%>
            <div :if={!sticker?(row.msg) && emoji_only?(row.msg)} class="flex items-center gap-2">
              <span class="text-[2.75rem] leading-none"><%= render_body(row.msg.body) %></span>
              <span class="flex items-center gap-0.5">
                <span class="text-[10px] leading-none text-muted whitespace-nowrap">
                  <%= chat_time(row.msg.inserted_at) %>
                </span>
                <.read_receipt :if={row.mine} read={row.msg.read} variant={:muted} />
              </span>
            </div>
            <div :if={!sticker?(row.msg) && !emoji_only?(row.msg)} class={[
              "chat-bubble max-w-[72%]",
              row.mine && "bg-accent text-white" || "chat-bubble-in text-body"
            ]}>
              <%!-- Quoted message. Clicking jumps to the original if it's still
                   in the loaded window; the browser ignores a missing anchor. --%>
              <%!-- max-w caps how far the quote can stretch the bubble: without
                   it a one-line quote dragged the bubble out to its full 72%
                   even when the reply itself was two words. --%>
              <a
                :if={quoted(row.msg)}
                href={"#msg-row-#{row.msg.reply_to_id}"}
                class={[
                  "block w-full max-w-[15rem] mb-1 mt-0.5 pl-2 pr-1.5 py-1 rounded-md border-l-2 no-underline",
                  row.mine && "border-white/70 bg-white/10" || "border-accent bg-accent-soft/50"
                ]}
              >
                <%= case quoted(row.msg) do %>
                  <% :deleted -> %>
                    <span class={[
                      "block text-[11px] leading-tight italic",
                      row.mine && "text-white/70" || "text-muted"
                    ]}>
                      <%= gettext("Deleted message") %>
                    </span>
                  <% parent -> %>
                    <span class={[
                      "block text-[11px] leading-tight font-semibold truncate",
                      row.mine && "text-white/90" || "text-accent"
                    ]}>
                      <%= quote_author(parent, @current_user) %>
                    </span>
                    <span class={[
                      "block text-[11px] leading-tight truncate",
                      row.mine && "text-white/70" || "text-muted"
                    ]}>
                      <%= quote_preview(parent) %>
                    </span>
                <% end %>
              </a>
              <%!-- Media/link embeds from URLs in the body (images, GIFs, YouTube…),
                   same detection as forum posts. --%>
              <div
                :for={emb <- message_embeds(row.msg.body)}
                class="chat-embed-fill mb-1 -mx-1.5 first:-mt-0.5 overflow-hidden rounded-2xl"
              >
                <ColloqWeb.ForumLive.Topic.media_embed embed={emb} />
              </div>
              <%!-- Link preview card, fetched asynchronously after the message was
                    sent. Unlike the media embeds above it keeps the URL in the
                    body: the card is extra context for the link, not a
                    replacement for it. --%>
              <%!-- Deliberately compact: a thumbnail beside two short lines, not a
                    banner card. A preview is a hint about where the link goes —
                    at full width it dwarfs the message that carried it. The
                    clamps are `chat-card-*` rather than line-clamp utilities so a
                    long title/description can't stretch the bubble even if the
                    stylesheet a client has cached predates them. --%>
              <a
                :for={emb <- link_previews(row.msg)}
                href={emb.url}
                target="_blank"
                rel="noopener noreferrer"
                class={[
                  "flex gap-2 items-start mb-1 mt-0.5 p-1.5 max-w-[16rem] rounded-lg no-underline border-l-[3px]",
                  (row.mine && "bg-white/10 border-white/70") || "bg-surface-alt border-accent"
                ]}
              >
                <img
                  :if={emb.image_url not in [nil, ""]}
                  src={emb.image_url}
                  alt=""
                  loading="lazy"
                  class="chat-card-thumb rounded object-cover flex-shrink-0"
                />
                <span class="block min-w-0 flex-1">
                  <span class={[
                    "block text-[10px] truncate",
                    (row.mine && "text-white/70") || "text-muted"
                  ]}>
                    <%= emb.host %>
                  </span>
                  <span class={[
                    "block text-[11px] font-semibold truncate",
                    (row.mine && "text-white") || "text-heading"
                  ]}>
                    <%= emb.title %>
                  </span>
                  <span
                    :if={emb.description not in [nil, ""]}
                    class={[
                      "chat-card-desc block text-[10px]",
                      (row.mine && "text-white/70") || "text-muted"
                    ]}
                  >
                    <%= emb.description %>
                  </span>
                </span>
              </a>
              <%!-- Body + inline timestamp & read receipt (Telegram-style) --%>
              <%!-- flex-1 on the body pins the meta to the bubble's right edge.
                   Without it the timestamp sat immediately after the text, which
                   stranded it mid-bubble whenever a quote made the bubble wider
                   than the reply itself. --%>
              <div class="flex items-end gap-2">
                <span
                  :if={has_text?(row.msg)}
                  class="flex-1 whitespace-pre-wrap break-words min-w-0"
                >
                  <%= render_body(row.msg.body) %>
                </span>
                <span class="flex items-center gap-0.5 self-end flex-shrink-0 ml-auto">
                  <span class={[
                    "text-[10px] leading-none whitespace-nowrap",
                    row.mine && "text-white/70" || "text-muted"
                  ]}>
                    <%= chat_time(row.msg.inserted_at) %>
                  </span>
                  <.read_receipt :if={row.mine} read={row.msg.read} />
                </span>
              </div>
            </div>
            <.msg_actions :if={!row.mine} row={row} />
          </div>
          </div>

          <div :if={@messages == []} class="flex flex-col items-center justify-center py-20 text-center">
            <div class="w-14 h-14 rounded-full bg-surface border border-border flex items-center justify-center mb-3">
              <.icon name="mail" class="w-7 h-7 text-muted" />
            </div>
            <p class="text-muted text-sm"><%= gettext("No messages yet. Write the first one!") %></p>
          </div>
        </div>
      </div>

      <%!-- Composer --%>
      <div class="px-4 py-3 border-t border-border bg-surface">
        <%!-- Reply strip: what the next message will quote. --%>
        <div
          :if={@replying_to}
          class="max-w-3xl mx-auto mb-2 flex items-center gap-2 rounded-xl border-l-2 border-accent bg-accent-soft/40 pl-2 pr-1 py-1.5"
        >
          <.icon name="reply" class="w-4 h-4 text-accent flex-shrink-0" />
          <div class="min-w-0 flex-1">
            <p class="text-[11px] font-semibold text-accent truncate">
              <%= gettext("Replying to %{who}", who: quote_author(@replying_to, @current_user)) %>
            </p>
            <p class="text-[11px] text-muted truncate"><%= message_preview(@replying_to) %></p>
          </div>
          <button
            type="button"
            phx-click="cancel-reply"
            title={gettext("Cancel reply")}
            class="p-1 rounded text-muted hover:text-heading flex-shrink-0"
          >
            <.icon name="x" class="w-4 h-4" />
          </button>
        </div>
        <form
          id="chat-form"
          phx-submit="send"
          phx-change="update_body"
          phx-hook="ChatComposer"
          class="flex items-end gap-2 max-w-3xl mx-auto"
        >
          <div class="flex-1 flex items-end gap-1 rounded-2xl border border-border bg-bg px-1.5 py-1 focus-within:border-accent focus-within:ring-2 focus-within:ring-accent/40 transition-colors">
            <textarea
              id="chat-input"
              name="body"
              placeholder={gettext("Write a message...")}
              class="flex-1 bg-transparent border-0 text-heading px-1 py-2 text-sm resize-none focus:outline-none focus:ring-0 max-h-32"
              rows="1"
            ><%= @message_body %></textarea>
            <button
              type="button"
              id="chat-sticker-btn"
              title={gettext("Stickers")}
              class="flex-shrink-0 flex items-center justify-center w-9 h-9 rounded-full text-muted hover:text-heading hover:bg-border transition-colors"
            >
              <.icon name="sticker" class="w-5 h-5" />
            </button>
            <button
              type="button"
              id="chat-emoji-btn"
              title={gettext("Emoji")}
              class="flex-shrink-0 flex items-center justify-center w-9 h-9 rounded-full text-muted hover:text-heading hover:bg-border transition-colors"
            >
              <.icon name="smile" class="w-5 h-5" />
            </button>
          </div>
          <button
            type="submit"
            title={gettext("Send")}
            class="flex-shrink-0 flex items-center justify-center w-11 h-11 rounded-full bg-accent text-white hover:bg-accent-hover active:scale-95 transition-all"
          >
            <.icon name="send" class="w-5 h-5" />
          </button>
        </form>
      </div>
    </div>

    <%!-- Empty state (no conversation selected). Desktop only: on a phone the
          list itself is the empty state, and this would cover it. --%>
    <div :if={!@active_conversation} class="hidden md:flex flex-1 items-center justify-center chat-pattern">
      <div class="text-center px-6">
        <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-surface border border-border flex items-center justify-center">
          <.icon name="mail" class="w-8 h-8 text-muted" />
        </div>
        <%= if @conversations == [] do %>
          <p class="text-heading text-lg font-semibold mb-1"><%= gettext("No conversations yet") %></p>
          <p class="text-muted text-sm"><%= gettext("Tap “+ New” to start one.") %></p>
        <% else %>
          <p class="text-heading text-lg font-semibold mb-1"><%= gettext("Select a conversation") %></p>
          <p class="text-muted text-sm"><%= gettext("Choose a contact from the list to start chatting.") %></p>
        <% end %>
      </div>
    </div>
  </div>

  <%!-- New conversation modal --%>
  <.modal :if={@show_new_conversation} id="new-conversation-modal" show={@show_new_conversation} on_cancel={JS.push("close-new-conversation")}>
    <:title><%= gettext("New message") %></:title>
    <form phx-change="search-users" phx-submit="search-users">
      <input
        type="text"
        name="q"
        value={@user_query}
        autocomplete="off"
        phx-debounce="200"
        placeholder={gettext("Search users by name…")}
        class="w-full rounded-lg border border-border bg-surface text-heading px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent"
      />
    </form>

    <div class="mt-3 max-h-72 overflow-y-auto">
      <p :if={@user_query != "" && @user_results == []} class="text-sm text-muted py-3 text-center">
        <%= gettext("No users found.") %>
      </p>
      <button
        :for={u <- @user_results}
        phx-click="start-conversation"
        phx-value-username={u.username}
        class="flex items-center gap-3 w-full text-left px-2 py-2 rounded-lg hover:bg-border transition-colors"
      >
        <div class="flex-shrink-0">
          <img :if={u.avatar_url} src={u.avatar_url} alt="" class="w-9 h-9 rounded-full object-cover" />
          <div :if={!u.avatar_url} class="w-9 h-9 rounded-full bg-accent flex items-center justify-center text-sm font-bold text-white">
            <%= String.slice(u.display_name || u.username, 0..0) |> String.upcase() %>
          </div>
        </div>
        <div class="min-w-0">
          <div class="text-sm font-medium text-heading truncate"><%= u.display_name || u.username %></div>
          <div class="text-xs text-muted truncate">@<%= u.username %></div>
        </div>
      </button>
    </div>
  </.modal>
</div>
